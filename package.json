{
  "name": "plot",
  "productName": "Plot",
  "version": "0.1.0",
  "description": "Understand pull requests and local code changes with readable diffs and optional AI overviews.",
  "license": "MIT",
  "private": true,
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "setup:electron": "install-electron",
    "postinstall": "npm run setup:electron",
    "predev": "npm run setup:electron",
    "dev": "node scripts/dev.mjs",
    "icons": "swift build/generate-icon.swift",
    "build": "electron-vite build",
    "prepreview": "npm run setup:electron",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit --composite false -p tsconfig.node.json && tsc --noEmit --composite false -p tsconfig.web.json",
    "lint": "npm run check:language && npm run test:language && biome check --error-on-warnings .",
    "check:language": "node scripts/check-language.mjs",
    "check:commit-language": "node scripts/check-language-commits.mjs",
    "test:language": "node --test scripts/check-language-tests.mjs",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "test:e2e": "npm run build && node e2e/smoke.mjs && node e2e/local-history.mjs && node e2e/review-readability.mjs",
    "test:e2e:review-readability": "npm run build && node e2e/review-readability.mjs",
    "test:e2e:local-history": "npm run build && node e2e/local-history.mjs",
    "test:dev-runtime": "node e2e/dev-runtime.mjs",
    "capture:docs": "npm run build && node e2e/capture-demo.mjs",
    "release:prepare": "node scripts/prepare-release.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@fontsource/fira-code": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/inconsolata": "^5.3.0",
    "@fontsource/iosevka": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/roboto-mono": "^5.3.0",
    "@tanstack/react-query": "^5.105.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "^4.14.0",
    "dompurify": "^3.4.17",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "elkjs": "0.9.3",
    "jsdom": "^30.1.3",
    "lucide-react": "^1.62.0",
    "mermaid": "^12.2.0",
    "monaco-editor": "^0.57.0",
    "playwright": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "monaco-editor": {
      "dompurify": "$dompurify"
    },
    "minimatch@>=9 <11": "^11.0.3"
  },
  "author": "JaeMin Seo"
}
